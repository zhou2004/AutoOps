{
 "Debug": false,
 "UseSuperReadOnly": true,
 "ListenAddress": ":13000",
 "BackendDB": "sqlite",
 "SQLite3DataFile": "/var/lib/autoops-orchestrator/orchestrator.db",
 "AuthenticationMethod": "basic",
 "HTTPAuthUser": "autoops",
 "HTTPAuthPassword": {{ orc_http_password | to_json }},
 "MySQLTopologyUser": "autoops_orc",
 "MySQLTopologyPassword": {{ orc_topology_pass | to_json }},
 "MySQLConnectTimeoutSeconds": 3,
 "DefaultInstancePort": {{ database_port }},
 "InstancePollSeconds": 5,
 "HostnameResolveMethod": "none",
 "MySQLHostnameResolveMethod": "@@report_host",
 "DetectClusterAliasQuery": {{ ("SELECT '" + database_name + "'") | to_json }},
 "RecoverMasterClusterFilters": ["*"],
 "RecoverIntermediateMasterClusterFilters": ["*"],
 "ApplyMySQLPromotionAfterMasterFailover": true,
 "RecoveryPeriodBlockSeconds": 60,
 "PreventCrossDataCenterMasterFailover": false,
 "RaftEnabled": {{ (orc_nodes | length == 3) | to_json }},
 "RaftDataDir": "/var/lib/autoops-orchestrator/raft",
 "RaftBind": {{ database_address | to_json }},
 "RaftAdvertise": {{ database_address | to_json }},
 "DefaultRaftPort": 11008,
 "RaftNodes": {{ orc_nodes | to_json }}
}
