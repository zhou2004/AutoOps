# Both docker/*/Dockerfile builds use the repository root as their context.
# Include only application source and required deployment assets.
*
!api/
!api/**
!web/
!web/**
!docker/
!docker/web/
!docker/web/devops.conf
!docker/kubeasz/
!docker/kubeasz/install-system.sh

**/.git
**/node_modules
**/dist
**/dist-ssr
**/.idea
**/.vscode
**/.env.local
**/.env.*.local
**/.env
!web/.env
**/*.log
**/*.tmp
**/*.tsbuildinfo
**/.eslintcache
**/.DS_Store
**/*_test.go
# Some production Vue views live under K8s/test; exclude backend tests only.
api/test
api/tests
**/.ssh
**/ssh_keys
**/id_rsa*
**/id_ed25519*
**/*.key
web/.env.development
api/config*.yaml
api/config*.yml
api/data
api/log
api/logs
api/tmp
api/temp
api/vendor
api/devops
api/dodevops-api
api/upload/**
!api/upload/xlsl/
!api/upload/xlsl/host.xlsx
